#!/bin/bash

# Mads' Dotfiles Setup Script
# Symlinks dotfiles and configuration files to their proper locations

set -e

DOTFILES_ROOT=$(pwd -P)

info() {
  printf "\r  [ \033[00;34m..\033[0m ] $1\n"
}

user() {
  printf "\r  [ \033[0;33m??\033[0m ] $1\n"
}

success() {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

fail() {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit 1
}

link_file() {
  local src=$1 dst=$2

  local overwrite= backup= skip=
  local action=

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]; then
    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]; then
      local currentSrc="$(readlink $dst)"

      if [ "$currentSrc" == "$src" ]; then
        skip=true;
      else
        user "File already exists: $dst ($(basename "$src")), what do you want to do?\n\
        [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
        read -n 1 action

        case "$action" in
          o )
            overwrite=true;;
          O )
            overwrite_all=true;;
          b )
            backup=true;;
          B )
            backup_all=true;;
          s )
            skip=true;;
          S )
            skip_all=true;;
          * )
            ;;
        esac
      fi
    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]; then
      rm -rf "$dst"
      success "removed $dst"
    fi

    if [ "$backup" == "true" ]; then
      mv "$dst" "${dst}.backup"
      success "moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]; then
      success "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]; then  # "false" or empty
    ln -s "$1" "$2"
    success "linked $1 to $2"
  fi
}

install_dotfiles() {
  info 'installing dotfiles'

  local overwrite_all=false backup_all=false skip_all=false

  # Link files from dot/ directory
  for src in $(find -H "$DOTFILES_ROOT/dot" -maxdepth 1 -name '*' -not -path "$DOTFILES_ROOT/dot"); do
    dst="$HOME/.$(basename "${src}")"
    link_file "$src" "$dst"
  done

  # Link configuration files
  if [ -d "$DOTFILES_ROOT/files/config" ]; then
    info 'linking config files'
    mkdir -p "$HOME/.config"
    
    for src in $(find -H "$DOTFILES_ROOT/files/config" -maxdepth 1 -name '*' -not -path "$DOTFILES_ROOT/files/config"); do
      dst="$HOME/.config/$(basename "${src}")"
      link_file "$src" "$dst"
    done
  fi

  # Link scripts from files/bin/ to ~/.local/bin/
  if [ -d "$DOTFILES_ROOT/files/bin" ]; then
    info 'linking bin scripts'
    mkdir -p "$HOME/.local/bin"

    for src in $(find -H "$DOTFILES_ROOT/files/bin" -maxdepth 1 -type f); do
      dst="$HOME/.local/bin/$(basename "${src}")"
      link_file "$src" "$dst"
    done
  fi

  # Link Cursor settings if they exist
  if [ -f "$DOTFILES_ROOT/files/config/cursor/settings.json" ]; then
    info 'linking Cursor settings'
    mkdir -p "$HOME/Library/Application Support/Cursor/User"
    link_file "$DOTFILES_ROOT/files/config/cursor/settings.json" "$HOME/Library/Application Support/Cursor/User/settings.json"
  fi
}

install_agent_config() {
  if [ ! -d "$DOTFILES_ROOT/agents" ]; then
    return
  fi

  info 'installing agent config'

  local overwrite_all=false backup_all=false skip_all=false
  local codex_skills_dir current_src installed_skill installed_target code_entry

  mkdir -p "$HOME/.claude" "$HOME/.codex" "$HOME/.agents"

  if [ -d "$DOTFILES_ROOT/agents/rules/cursor" ]; then
    info 'installing Cursor rules'
    mkdir -p "$HOME/.cursor/rules"

    for src in "$DOTFILES_ROOT"/agents/rules/cursor/*.mdc; do
      [ -e "$src" ] || continue
      link_file "$src" "$HOME/.cursor/rules/$(basename "$src")"
    done
  fi

  if [ -f "$DOTFILES_ROOT/agents/rules/cursor/mads-preferences.mdc" ]; then
    link_file "$DOTFILES_ROOT/agents/rules/cursor/mads-preferences.mdc" "$HOME/.codex/AGENTS.md"
  fi

  if [ -d "$DOTFILES_ROOT/agents/rules/code" ]; then
    info 'installing code-wide agent rules'
    mkdir -p "$HOME/Code"

    for code_entry in AGENTS.md CLAUDE.md; do
      if [ -f "$DOTFILES_ROOT/agents/rules/code/$code_entry" ]; then
        link_file "$DOTFILES_ROOT/agents/rules/code/$code_entry" "$HOME/Code/$code_entry"
      fi
    done
  fi

  if [ -d "$DOTFILES_ROOT/agents/skills" ]; then
    link_file "$DOTFILES_ROOT/agents/skills" "$HOME/.claude/skills"

    codex_skills_dir="$HOME/.agents/skills"
    if [ -L "$codex_skills_dir" ]; then
      current_src="$(readlink "$codex_skills_dir")"
      if [ "$current_src" = "$DOTFILES_ROOT/agents/skills" ]; then
        unlink "$codex_skills_dir"
      else
        fail "Refusing to replace Codex skills link: $codex_skills_dir -> $current_src"
      fi
    fi
    mkdir -p "$codex_skills_dir"

    for installed_skill in "$codex_skills_dir"/*; do
      [ -L "$installed_skill" ] || continue
      installed_target="$(readlink "$installed_skill")"
      case "$installed_target" in
        "$DOTFILES_ROOT/agents/skills/"*)
          if [ ! -d "$installed_target" ] || [ "$(basename "$installed_skill")" = "skill-creator" ]; then
            unlink "$installed_skill"
          fi
          ;;
      esac
    done

    for src in "$DOTFILES_ROOT"/agents/skills/*; do
      [ -d "$src" ] || continue
      [ "$(basename "$src")" != "skill-creator" ] || continue
      link_file "$src" "$codex_skills_dir/$(basename "$src")"
    done
  fi

  if [ -d "$DOTFILES_ROOT/agents/agents" ]; then
    link_file "$DOTFILES_ROOT/agents/agents" "$HOME/.claude/agents"
  fi

  if [ -f "$DOTFILES_ROOT/agents/settings/claude/settings.json" ]; then
    link_file "$DOTFILES_ROOT/agents/settings/claude/settings.json" "$HOME/.claude/settings.json"
  fi

  if [ -f "$DOTFILES_ROOT/agents/settings/claude/statusline.sh" ]; then
    link_file "$DOTFILES_ROOT/agents/settings/claude/statusline.sh" "$HOME/.claude/statusline.sh"
  fi
}

install_oh_my_zsh() {
  if [ ! -d "$HOME/.oh-my-zsh" ]; then
    info "Installing oh-my-zsh"
    sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
    success "oh-my-zsh installed"
  else
    success "oh-my-zsh already installed"
  fi
}

install_zsh_plugins() {
  local ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

  # Install zsh-autosuggestions
  if [ ! -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ]; then
    info "Installing zsh-autosuggestions"
    git clone https://github.com/zsh-users/zsh-autosuggestions "$ZSH_CUSTOM/plugins/zsh-autosuggestions"
    success "zsh-autosuggestions installed"
  else
    success "zsh-autosuggestions already installed"
  fi

  # Install zsh-syntax-highlighting
  if [ ! -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ]; then
    info "Installing zsh-syntax-highlighting"
    git clone https://github.com/zsh-users/zsh-syntax-highlighting "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting"
    success "zsh-syntax-highlighting installed"
  else
    success "zsh-syntax-highlighting already installed"
  fi
}

echo ''
echo '🚀 Setting up dotfiles...'
echo ''

install_oh_my_zsh
install_zsh_plugins
install_dotfiles
install_agent_config

echo ''
echo '✅ All dotfiles installed!'
echo ''
echo 'You may want to restart your terminal to see the changes.'
echo ''
